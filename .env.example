# Copy to .env before running the LIVE integration suite:
#     gltest tests/integration -v -s --network studionet
#
# The direct suite needs none of this — `pytest tests/direct/` runs
# offline with no keys.
#
# Two funded StudioNet accounts, so requester and agent are genuinely
# different wallets and the authorisation guards are actually exercised.
# Never commit the filled-in .env.
VERITY_REQUESTER_KEY=0x<private key of a funded StudioNet account>
VERITY_AGENT_KEY=0x<private key of a second funded StudioNet account>

# Set to 1 to skip the two slow live-panel rounds and run only the
# fast on-chain checks.
VERITY_SKIP_PANEL=0
